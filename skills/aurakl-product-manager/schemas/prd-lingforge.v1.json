{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/prd-lingforge/v1",
  "title": "LingforgePRDSpecV1",
  "description": "Lingforge style PRD specification with SMART goals, modular feature blocks, NFR tables, and risk hypotheses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "overview",
    "features",
    "non_functional_requirements",
    "dependencies_and_constraints",
    "risks_and_assumptions",
    "version_history"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version",
        "title",
        "status",
        "author",
        "created",
        "updated",
        "depends_on",
        "implements",
        "tags",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prd-[a-z0-9-]+-v[0-9.]+$"
        },
        "type": {
          "type": "string",
          "const": "prd"
        },
        "version": {
          "type": [
            "string",
            "number"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "objectives",
        "scope"
      ],
      "properties": {
        "background": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric_name",
              "baseline",
              "target",
              "timeframe"
            ],
            "properties": {
              "metric_name": {
                "type": "string",
                "minLength": 1
              },
              "baseline": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "timeframe": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in_scope",
            "out_of_scope"
          ],
          "properties": {
            "in_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "out_of_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item",
                  "reason"
                ],
                "properties": {
                  "item": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "implements_story_id",
          "name",
          "user_story",
          "priority",
          "story_id",
          "feature_id",
          "preconditions",
          "description",
          "main_flow",
          "exception_handling",
          "inputs",
          "outputs",
          "error_handling",
          "acceptance_criteria",
          "boundary_conditions",
          "business_rules",
          "test_requirements",
          "related_design"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^REQ-F[0-9]{3}$"
          },
          "implements_story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-F[0-9]{3}$"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "user_story": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "target",
              "benefit"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "benefit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "Must Have",
              "Should Have",
              "Could Have",
              "Wont Have",
              "Must",
              "Should",
              "Could",
              "P0",
              "P1",
              "P2"
            ]
          },
          "story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
          },
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dependencies",
              "state_prerequisites",
              "permissions",
              "usage_scenario"
            ],
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state_prerequisites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "usage_scenario": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "main_flow": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_num",
                "user_action",
                "system_response"
              ],
              "properties": {
                "step_num": {
                  "type": "integer",
                  "minimum": 1
                },
                "user_action": {
                  "type": "string",
                  "minLength": 1
                },
                "system_response": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "exception_handling": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "handling"
              ],
              "properties": {
                "scenario": {
                  "type": "string",
                  "minLength": 1
                },
                "handling": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "type",
                "required",
                "description",
                "constraints",
                "example"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "constraints": {
                  "type": "string"
                },
                "example": {
                  "type": "string"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "type",
                "description",
                "example"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "example": {
                  "type": "string"
                }
              }
            }
          },
          "error_handling": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "scenario",
                "user_message",
                "suggestion"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "scenario": {
                  "type": "string",
                  "minLength": 1
                },
                "user_message": {
                  "type": "string",
                  "minLength": 1
                },
                "suggestion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ac_id",
                "given",
                "when",
                "then"
              ],
              "properties": {
                "ac_id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]{3}$"
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "boundary_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "business_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "normal",
              "boundary",
              "error",
              "performance",
              "security"
            ],
            "properties": {
              "normal": {
                "type": "boolean"
              },
              "boundary": {
                "type": "boolean"
              },
              "error": {
                "type": "boolean"
              },
              "performance": {
                "type": "boolean"
              },
              "security": {
                "type": "boolean"
              }
            }
          },
          "related_design": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "non_functional_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance",
        "security",
        "compatibility"
      ],
      "properties": {
        "performance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "requirement",
              "metric"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "security": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "requirement",
              "measure"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "measure": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "supported_versions"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "supported_versions": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dependencies_and_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencies",
        "constraints"
      ],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "description"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mvp_excludes",
            "technical_constraints"
          ],
          "properties": {
            "mvp_excludes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "technical_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "risks_and_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risks",
        "assumptions"
      ],
      "properties": {
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "description",
              "likelihood",
              "impact",
              "mitigation"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "likelihood": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assumption",
              "validation_method",
              "fallback"
            ],
            "properties": {
              "assumption": {
                "type": "string",
                "minLength": 1
              },
              "validation_method": {
                "type": "string",
                "minLength": 1
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "version_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "changes",
          "author"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "changes": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/competitor-intel-evidence/v1",
  "title": "CompetitorIntelEvidenceV1",
  "description": "Step 02 competitor intelligence artifact: verified competitor URLs and factual evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "search_queries_used",
    "competitors_found",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "search_queries_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Core search terms and queries used for market intelligence gathering"
    },
    "competitors_found": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "description": "Verified competitor intelligence evidence items",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "reference_url",
          "evidence_summary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "potential_substitute"
            ]
          },
          "reference_url": {
            "type": "string",
            "minLength": 1,
            "description": "Competitor official URL, pricing page, or verified public factual sources"
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1,
            "description": "Direct excerpts of positioning, features, and pricing gathered via WebFetch"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

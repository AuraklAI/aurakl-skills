{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product/user-story-set/v1",
  "title": "User Story Suite",
  "description": "Step 03 artifact: user story suite adhering to INVEST principles and traceability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epics",
    "stories"
  ],
  "properties": {
    "epics": {
      "type": "array",
      "description": "Decomposed by user journey or core scenario, not technical tiers",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "value",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Core user value achieved upon successful journey completion"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_epic",
          "as_a",
          "i_want",
          "so_that",
          "priority",
          "estimate_days",
          "implements",
          "source_quote",
          "acceptance_scenarios"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$",
            "description": "USR-<MODULE>-001 unique story identifier"
          },
          "parent_epic": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "as_a": {
            "type": "string",
            "minLength": 1,
            "description": "Specific persona (e.g. 'First-Time Buyer'), avoiding generic 'User' or 'System'"
          },
          "i_want": {
            "type": "string",
            "minLength": 1,
            "description": "Capability statement, not UI mockup detail"
          },
          "so_that": {
            "type": "string",
            "minLength": 1,
            "description": "Clear user business value justifying the capability"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "estimate_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "INVEST Small sizing (split if exceeding 5 person-days)"
          },
          "implements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQA-[0-9]{3}$"
            },
            "description": "Requirement ID implemented by this story"
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "description": "Original citation from upstream requirement"
          },
          "blocked_by": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
            },
            "description": "INVEST Independent: blocked_by dependencies must not exceed 3"
          },
          "acceptance_scenarios": {
            "type": "array",
            "minItems": 1,
            "description": "P0 stories must have at least 1 happy, 1 boundary, and 1 error scenario",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "given",
                "when",
                "then"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "happy",
                    "boundary",
                    "error"
                  ]
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Observable assertable behavior, avoiding vague phrases like 'handled properly'"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}

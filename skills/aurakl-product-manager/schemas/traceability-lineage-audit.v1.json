{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/traceability-lineage-audit/v1",
  "title": "TraceabilityLineageAuditV1",
  "description": "Step 07 review artifact: end-to-end two-way lineage penetration audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "requirements_to_stories_coverage_pct",
    "stories_to_features_coverage_pct",
    "invariants_to_criteria_coverage_pct",
    "broken_reference_count",
    "lineage_chains",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "requirements_to_stories_coverage_pct": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 100.0
    },
    "stories_to_features_coverage_pct": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 100.0
    },
    "invariants_to_criteria_coverage_pct": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 100.0
    },
    "broken_reference_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "lineage_chains": {
      "type": "array",
      "minItems": 1,
      "description": "End-to-end causal lineage audit details",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "requirement_id",
          "story_id",
          "feature_id",
          "invariant_ids",
          "criterion_ids",
          "status"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3}$"
          },
          "story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
          },
          "feature_id": {
            "type": "string",
            "pattern": "^FEAT-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "invariant_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^INV-(STA|DAT|SEC|UXS)-[0-9]{3}$"
            }
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[A-Z0-9]{2,8}-[0-9]{3}$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "CONNECTED",
              "DISCONNECTED"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

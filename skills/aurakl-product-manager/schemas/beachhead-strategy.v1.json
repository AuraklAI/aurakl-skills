{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/beachhead-strategy/v1",
  "title": "BeachheadStrategyV1",
  "description": "Step 04 artifact: market gap analysis and differentiated beachhead entry strategy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "gap_analysis",
    "beachhead_strategy",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "gap_analysis": {
      "type": "object",
      "description": "Gap analysis of competitor offerings and unmet customer demands",
      "additionalProperties": false,
      "required": [
        "unmet_customer_needs",
        "feature_parity_gaps",
        "user_experience_frictions"
      ],
      "properties": {
        "unmet_customer_needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_parity_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_experience_frictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "beachhead_strategy": {
      "type": "object",
      "description": "Differentiated beachhead entry strategy",
      "additionalProperties": false,
      "required": [
        "target_niche",
        "entry_point_feature",
        "value_curve_differentiation"
      ],
      "properties": {
        "target_niche": {
          "type": "string",
          "minLength": 1,
          "description": "Initial niche target audience or high-priority core scenarios"
        },
        "entry_point_feature": {
          "type": "string",
          "minLength": 1,
          "description": "Killer wedge feature for sharp market penetration"
        },
        "value_curve_differentiation": {
          "type": "string",
          "minLength": 1,
          "description": "Value curve reconstruction (where to eliminate, reduce, raise, and create)"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

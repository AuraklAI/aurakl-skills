{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product/prd/v1",
  "title": "Product Requirements Document (PRD)",
  "description": "PRD draft artifact replacing markdown templates: universal sections are required, while platform variants enforce specific sections via product_type schema branching.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "background",
    "target_users",
    "do_not_change",
    "non_goals",
    "requirements",
    "success_metrics",
    "platform_specifics",
    "dependencies_and_risks",
    "milestones"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1,
      "description": "Must match product_name from upstream Requirement Analysis"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "description": "Why now and cost of inaction (derived from Requirement Analysis Why), not product intro."
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "description": "Stakeholders derived from Requirement Analysis",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "primary_job"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "primary_job": {
            "type": "string",
            "minLength": 1,
            "description": "Primary user task to accomplish in this product"
          }
        }
      }
    },
    "do_not_change": {
      "type": "array",
      "description": "Pre-existing immutable constraints (protocols, formats, behaviors); empty array if greenfield.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint",
          "reason"
        ],
        "properties": {
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "reason"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Explicit statement of what is excluded in this iteration or where scope ends"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "statement",
          "rfc2119",
          "priority",
          "implements",
          "source_quote",
          "acceptance_hints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z]{1,8}-[0-9]{3}$",
            "description": "REQ-<MODULE>-001"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "Owning business module: REQs within same module must share this value"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Single responsibility: describe exactly one capability; split if compound conjunctions appear."
          },
          "rfc2119": {
            "enum": [
              "MUST",
              "SHOULD",
              "MAY"
            ],
            "description": "At least 3 MUST requirements; MAY items must not exceed 30%"
          },
          "priority": {
            "enum": [
              "must_have",
              "should_have",
              "could_have",
              "wont_have"
            ],
            "description": "must_have items must not exceed 30% of total"
          },
          "implements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
            },
            "description": "User story ID implemented by this requirement"
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "exception": {
            "type": "string",
            "description": "Explicit exception condition required when using RFC 2119 SHOULD"
          },
          "acceptance_hints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Guidance hint for downstream Acceptance Criteria, not the test assertion itself"
          }
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "description": "Must be measurable independently in production as an acceptance signal",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "target",
          "measurement"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Concrete numerical target (e.g. 'increase from 62% to 70%')"
          },
          "measurement": {
            "type": "string",
            "minLength": 1,
            "description": "Measurement method (e.g. 'telemetry event funnel, weekly cadence')"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "platform_specifics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Platform-specific requirements enforced conditionally by product_type.",
      "required": [
        "product_type",
        "sections"
      ],
      "properties": {
        "product_type": {
          "enum": [
            "mobile",
            "desktop",
            "cloud_platform",
            "device_firmware",
            "multi_platform",
            "generic"
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "content"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "description": "Specific product decisions (metrics, policies, boundaries); state rationale if inapplicable."
              }
            }
          }
        }
      }
    },
    "dependencies_and_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "kind",
          "mitigation"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dependency",
              "risk"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "deliverable"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "target_date": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$comment": "mobile: required sections corresponding to mobile app specification",
      "if": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "product_type": {
                "const": "mobile"
              }
            },
            "required": [
              "product_type"
            ]
          }
        },
        "required": [
          "platform_specifics"
        ]
      },
      "then": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "sections": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "onboarding"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include onboarding section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "push_notifications"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include push_notifications section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "permissions"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include permissions section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "offline_experience"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include offline_experience section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "platform_differences"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include platform_differences section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "store_requirements"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include store_requirements section"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "desktop: required sections corresponding to desktop application specification",
      "if": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "product_type": {
                "const": "desktop"
              }
            },
            "required": [
              "product_type"
            ]
          }
        },
        "required": [
          "platform_specifics"
        ]
      },
      "then": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "sections": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "system_requirements"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include system_requirements section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "install_and_update"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include install_and_update section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "local_storage"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include local_storage section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "os_integration"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include os_integration section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "offline_and_network"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include offline_and_network section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "crash_handling"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include crash_handling section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "accessibility"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include accessibility section"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "cloud_platform: required sections corresponding to cloud platform specification",
      "if": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "product_type": {
                "const": "cloud_platform"
              }
            },
            "required": [
              "product_type"
            ]
          }
        },
        "required": [
          "platform_specifics"
        ]
      },
      "then": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "sections": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "service_modules"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include service_modules section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "data_storage"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include data_storage section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "privacy_compliance"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include privacy_compliance section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "sla"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include sla section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "background_jobs"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include background_jobs section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "admin_console"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include admin_console section"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "device_firmware: required sections corresponding to device firmware specification",
      "if": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "product_type": {
                "const": "device_firmware"
              }
            },
            "required": [
              "product_type"
            ]
          }
        },
        "required": [
          "platform_specifics"
        ]
      },
      "then": {
        "properties": {
          "platform_specifics": {
            "properties": {
              "sections": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "device_state_machine"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include device_state_machine section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "power_budget"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include power_budget section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "cloud_protocol"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include cloud_protocol section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "local_storage"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include local_storage section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "ota_upgrade"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include ota_upgrade section"
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "multimodal_feedback"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "$comment": "Must include multimodal_feedback section"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

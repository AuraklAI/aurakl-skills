{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/user-story-lingforge/v1",
  "title": "LingforgeUserStorySpecV1",
  "description": "Lingforge style user story specification with Epics, INVEST stories, and priority matrices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "overview",
    "epics",
    "stories",
    "personas",
    "journeys",
    "priority_matrix",
    "downstream_deliverables",
    "version_history"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version",
        "title",
        "status",
        "author",
        "created",
        "updated",
        "implements",
        "tags",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^story-[a-z0-9-]+-v[0-9.]+$"
        },
        "type": {
          "type": "string",
          "const": "story"
        },
        "version": {
          "type": [
            "string",
            "number"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "implements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        }
      }
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "goal",
          "business_value",
          "contained_stories",
          "priority",
          "estimated_effort"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EPIC-[A-Z0-9-]+-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "business_value": {
            "type": "string",
            "minLength": 1
          },
          "contained_stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "Must",
              "Should",
              "Could",
              "P0",
              "P1",
              "P2"
            ]
          },
          "estimated_effort": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "implements_epic",
          "as_a",
          "i_want",
          "so_that",
          "priority",
          "estimated_effort",
          "sprint",
          "background",
          "acceptance_criteria",
          "dependencies",
          "ui_ux_notes",
          "technical_constraints",
          "success_metrics",
          "related_prd"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "implements_epic": {
            "type": "string",
            "pattern": "^EPIC-[A-Z0-9-]+-[0-9]{3}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
            }
          },
          "as_a": {
            "type": "string",
            "minLength": 1
          },
          "i_want": {
            "type": "string",
            "minLength": 1
          },
          "so_that": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "Must",
              "Should",
              "Could",
              "Must Have",
              "Should Have",
              "Could Have",
              "P0",
              "P1",
              "P2"
            ]
          },
          "estimated_effort": {
            "type": "string",
            "minLength": 1
          },
          "sprint": {
            "type": "string",
            "minLength": 1
          },
          "background": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "given",
                "when",
                "then"
              ],
              "properties": {
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ui_ux_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "technical_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "success_metrics": {
            "type": "string",
            "minLength": 1
          },
          "related_prd": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "demographics",
          "pain_points",
          "goals_and_needs",
          "related_stories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(PERSONA|PSA)-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "demographics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age_range",
              "occupation",
              "tech_level",
              "usage_context"
            ],
            "properties": {
              "age_range": {
                "type": "string",
                "minLength": 1
              },
              "occupation": {
                "type": "string",
                "minLength": 1
              },
              "tech_level": {
                "type": "string",
                "minLength": 1
              },
              "usage_context": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "pain_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "goals_and_needs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goals",
              "needs"
            ],
            "properties": {
              "goals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "needs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "related_stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
            }
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scenario",
          "involved_personas",
          "steps",
          "current_pain_points",
          "improvements",
          "involved_stories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^JOURNEY-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "involved_personas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(PERSONA|PSA)-[0-9]{3}$"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_action",
                "system_response",
                "user_feeling"
              ],
              "properties": {
                "user_action": {
                  "type": "string",
                  "minLength": 1
                },
                "system_response": {
                  "type": "string",
                  "minLength": 1
                },
                "user_feeling": {
                  "type": "string",
                  "minLength": 1
                },
                "related_story": {
                  "type": "string",
                  "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
                }
              }
            }
          },
          "current_pain_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "improvements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "involved_stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
            }
          }
        }
      }
    },
    "priority_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_have",
        "should_have",
        "could_have"
      ],
      "properties": {
        "must_have": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_id",
              "title",
              "business_value",
              "tech_complexity",
              "dependencies",
              "estimated_effort"
            ],
            "properties": {
              "story_id": {
                "type": "string",
                "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "business_value": {
                "type": "string",
                "minLength": 1
              },
              "tech_complexity": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "string",
                "minLength": 1
              },
              "estimated_effort": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "should_have": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_id",
              "title",
              "business_value",
              "tech_complexity",
              "dependencies",
              "estimated_effort"
            ],
            "properties": {
              "story_id": {
                "type": "string",
                "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "business_value": {
                "type": "string",
                "minLength": 1
              },
              "tech_complexity": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "string",
                "minLength": 1
              },
              "estimated_effort": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "could_have": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story_id",
              "title",
              "business_value",
              "tech_complexity",
              "dependencies",
              "estimated_effort"
            ],
            "properties": {
              "story_id": {
                "type": "string",
                "pattern": "^USR-[A-Z0-9-]+-[0-9]{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "business_value": {
                "type": "string",
                "minLength": 1
              },
              "tech_complexity": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "string",
                "minLength": 1
              },
              "estimated_effort": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "upstream_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downstream_deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prd",
        "acceptance_criteria"
      ],
      "properties": {
        "prd": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "version_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "changes",
          "author"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "changes": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

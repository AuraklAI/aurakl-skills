{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/acceptance-criteria/v2",
  "title": "AcceptanceCriteriaV2",
  "description": "Step 06 artifact: Gherkin acceptance test suite enforcing 100% invariant coverage and >= 30% defensive negative scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "scenarios",
    "invariant_coverage_matrix",
    "negative_case_distribution",
    "definition_of_done",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "description": "Gherkin executable acceptance test scenario suite",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "story_id",
          "scenario_title",
          "scenario_type",
          "given",
          "when",
          "then",
          "verifies_invariant_id"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
          },
          "scenario_title": {
            "type": "string",
            "minLength": 1
          },
          "scenario_type": {
            "type": "string",
            "enum": [
              "happy_path",
              "boundary_condition",
              "negative_defense",
              "fault_recovery"
            ]
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "verifies_invariant_id": {
            "type": "string",
            "pattern": "^INV-(STA|DAT|SEC|UXS)-[0-9]{3}$"
          }
        }
      }
    },
    "invariant_coverage_matrix": {
      "type": "object",
      "description": "Coverage matrix metrics over product invariants",
      "additionalProperties": false,
      "required": [
        "total_invariants_count",
        "covered_invariants_count",
        "coverage_ratio_basis_points",
        "all_invariants_covered"
      ],
      "properties": {
        "total_invariants_count": {
          "type": "integer",
          "minimum": 1
        },
        "covered_invariants_count": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_ratio_basis_points": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 10000,
          "description": "Must be 10000 (100.0% in basis points)"
        },
        "all_invariants_covered": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      }
    },
    "negative_case_distribution": {
      "type": "object",
      "description": "Distribution metrics of negative and defensive test scenarios",
      "additionalProperties": false,
      "required": [
        "total_scenarios_count",
        "negative_defense_scenarios_count",
        "negative_percentage",
        "meets_safety_threshold"
      ],
      "properties": {
        "total_scenarios_count": {
          "type": "integer",
          "minimum": 1
        },
        "negative_defense_scenarios_count": {
          "type": "integer",
          "minimum": 1
        },
        "negative_percentage": {
          "type": "number",
          "minimum": 30.0
        },
        "meets_safety_threshold": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      }
    },
    "definition_of_done": {
      "type": "object",
      "description": "Release and deployment gate criteria",
      "additionalProperties": false,
      "required": [
        "blocking_release_gates",
        "advisory_quality_checks"
      ],
      "properties": {
        "blocking_release_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisory_quality_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

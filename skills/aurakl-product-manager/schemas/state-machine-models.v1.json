{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/state-machine-models/v1",
  "title": "StateMachineModelsV1",
  "description": "Step 04 PRD artifact: deterministic state machines and lifecycle models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "state_machines",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "state_machines": {
      "type": "array",
      "minItems": 1,
      "description": "Core business entity state machine models",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_name",
          "states",
          "transitions"
        ],
        "properties": {
          "entity_name": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state_id",
                "state_name",
                "is_initial",
                "is_terminal"
              ],
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "state_name": {
                  "type": "string",
                  "minLength": 1
                },
                "is_initial": {
                  "type": "boolean"
                },
                "is_terminal": {
                  "type": "boolean"
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_state",
                "to_state",
                "trigger_event",
                "action"
              ],
              "properties": {
                "from_state": {
                  "type": "string",
                  "minLength": 1
                },
                "to_state": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger_event": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

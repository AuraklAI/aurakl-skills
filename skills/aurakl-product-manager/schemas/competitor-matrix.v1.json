{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/competitor-matrix/v1",
  "title": "CompetitorMatrixV1",
  "description": "Step 03 artifact: cross-competitor benchmarking matrix.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "competitors",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "competitors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "description": "Cross-competitor benchmarking matrix",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "core_features",
          "strengths",
          "weaknesses",
          "pricing_model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "potential_substitute"
            ]
          },
          "core_features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strengths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "weaknesses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pricing_model": {
            "type": "string",
            "minLength": 1
          },
          "reference_url": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

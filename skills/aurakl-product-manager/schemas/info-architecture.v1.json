{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/info-architecture/v1",
  "title": "InformationArchitectureV1",
  "description": "Step 04 artifact: background, metrics, Non-Goals, personas, and IA topology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "background",
    "target_users",
    "goals",
    "non_goals",
    "information_architecture",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "primary_job"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "primary_job": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "reason"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "information_architecture": {
      "type": "object",
      "description": "System information architecture and module topology",
      "additionalProperties": false,
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "module_name",
              "description",
              "hierarchy_level"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^MOD-[A-Z0-9]{2,8}$"
              },
              "module_name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "hierarchy_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

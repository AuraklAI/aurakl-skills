{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/negative-defense-scenarios/v1",
  "title": "NegativeDefenseScenariosV1",
  "description": "Step 06 artifact: 100% invariant coverage defensive and fault-recovery test cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "negative_defense_scenarios",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "negative_defense_scenarios": {
      "type": "array",
      "minItems": 1,
      "description": "Negative defensive and fault injection recovery test suite",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "story_id",
          "scenario_title",
          "scenario_type",
          "given",
          "when",
          "then",
          "verifies_invariant_id"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
          },
          "scenario_title": {
            "type": "string",
            "minLength": 1
          },
          "scenario_type": {
            "type": "string",
            "enum": [
              "negative_defense",
              "fault_recovery"
            ]
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "verifies_invariant_id": {
            "type": "string",
            "pattern": "^INV-(STA|DAT|SEC|UXS)-[0-9]{3}$"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

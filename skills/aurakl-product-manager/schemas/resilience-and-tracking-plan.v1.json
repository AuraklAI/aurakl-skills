{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/resilience-and-tracking-plan/v1",
  "title": "ResilienceAndTrackingPlanV1",
  "description": "Step 04 artifact: exception recovery matrix and tracking plan dictionary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "error_handling_and_recovery",
    "tracking_plan",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "error_handling_and_recovery": {
      "type": "object",
      "description": "Error handling, interruption recovery, and graceful degradation specification",
      "additionalProperties": false,
      "required": [
        "system_errors",
        "business_exceptions",
        "interruption_and_recovery"
      ],
      "properties": {
        "system_errors": {
          "type": "array",
          "minItems": 1,
          "description": "System-level exception handling (network timeout, rate limiting, unavailable dependency)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "error_code",
              "trigger_scenario",
              "retry_policy",
              "fallback_strategy"
            ],
            "properties": {
              "error_code": {
                "type": "string",
                "minLength": 1
              },
              "trigger_scenario": {
                "type": "string",
                "minLength": 1
              },
              "retry_policy": {
                "type": "string",
                "minLength": 1
              },
              "fallback_strategy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "business_exceptions": {
          "type": "array",
          "minItems": 1,
          "description": "Business exception handling (invalid input, concurrency conflicts, unauthorized access)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exception_code",
              "condition",
              "user_facing_message",
              "recovery_action"
            ],
            "properties": {
              "exception_code": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "user_facing_message": {
                "type": "string",
                "minLength": 1
              },
              "recovery_action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "interruption_and_recovery": {
          "type": "object",
          "description": "User active and passive interruption recovery protocol",
          "additionalProperties": false,
          "required": [
            "draft_persistence_strategy",
            "session_resume_protocol",
            "idempotency_guarantees"
          ],
          "properties": {
            "draft_persistence_strategy": {
              "type": "string",
              "minLength": 1,
              "description": "Autosave mechanism for draft state and interrupted input (e.g. LocalStorage / draft queue)"
            },
            "session_resume_protocol": {
              "type": "string",
              "minLength": 1,
              "description": "Lossless session restoration workflow upon user re-entry"
            },
            "idempotency_guarantees": {
              "type": "string",
              "minLength": 1,
              "description": "Idempotency and deduplication mechanisms under retries and poor network conditions"
            }
          }
        }
      }
    },
    "tracking_plan": {
      "type": "object",
      "description": "Tracking Plan telemetry dictionary and analytics metrics",
      "additionalProperties": false,
      "required": [
        "north_star_metric",
        "funnel_metrics",
        "event_dictionary",
        "quality_telemetry"
      ],
      "properties": {
        "north_star_metric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_name",
            "target_definition",
            "business_impact"
          ],
          "properties": {
            "metric_name": {
              "type": "string",
              "minLength": 1
            },
            "target_definition": {
              "type": "string",
              "minLength": 1
            },
            "business_impact": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "funnel_metrics": {
          "type": "array",
          "minItems": 1,
          "description": "Core business conversion funnel KPIs",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_name",
              "conversion_formula",
              "target_benchmark"
            ],
            "properties": {
              "step_name": {
                "type": "string",
                "minLength": 1
              },
              "conversion_formula": {
                "type": "string",
                "minLength": 1
              },
              "target_benchmark": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "event_dictionary": {
          "type": "array",
          "minItems": 2,
          "description": "User behavioral event telemetry schema",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_name",
              "trigger_condition",
              "event_properties",
              "user_properties"
            ],
            "properties": {
              "event_name": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$",
                "description": "e.g. order_submitted, search_executed"
              },
              "trigger_condition": {
                "type": "string",
                "minLength": 1
              },
              "event_properties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "user_properties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "quality_telemetry": {
          "type": "array",
          "minItems": 1,
          "description": "System performance and UX telemetry health indicators",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "telemetry_name",
              "alert_threshold",
              "sla_target"
            ],
            "properties": {
              "telemetry_name": {
                "type": "string",
                "minLength": 1
              },
              "alert_threshold": {
                "type": "string",
                "minLength": 1
              },
              "sla_target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

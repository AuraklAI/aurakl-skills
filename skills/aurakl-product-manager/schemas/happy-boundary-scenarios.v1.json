{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/happy-boundary-scenarios/v1",
  "title": "HappyBoundaryScenariosV1",
  "description": "Step 06 artifact: happy path and boundary value Gherkin acceptance test scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "happy_and_boundary_scenarios",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "happy_and_boundary_scenarios": {
      "type": "array",
      "minItems": 1,
      "description": "Happy path and boundary acceptance test suite",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "story_id",
          "scenario_title",
          "scenario_type",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "story_id": {
            "type": "string",
            "pattern": "^USR-[A-Z]{1,6}-[0-9]{3}$"
          },
          "scenario_title": {
            "type": "string",
            "minLength": 1
          },
          "scenario_type": {
            "type": "string",
            "enum": [
              "happy_path",
              "boundary_condition"
            ]
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

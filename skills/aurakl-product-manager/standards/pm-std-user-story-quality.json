            "locator": "whole_subject_allowed",
            "binding": "target",
            "freshness": "target_bound",
            "provenance": "independent_from_producer"
          }
        ]
      },
      {
        "id": "us.traceable",
        "statement": "Every story must declare the requirement ID it implements and include supporting requirement excerpts",

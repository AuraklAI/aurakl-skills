  "spec": {
    "name": "User Story Quality Standard",
    "scope": "step",
    "rules": [
      {
        "id": "us.three_part_form",
        "statement": "Every story must use the Three-Part format (As a / I want to / So that) with specific user personas rather than System",
        "enforceability": "requires_criterion",
        "criterion_hint": "stories_are_invest_shaped",
        "evidence_hint": [
          {
            "required_fields": [
              {
                "semantics": "rfc6901",
                "pointer": "/samples"
              },
              {
                "semantics": "rfc6901",
                "pointer": "/agreement_basis_points"
              }
            ],
            "locator": "whole_subject_allowed",
            "binding": "target",
            "freshness": "target_bound",
            "provenance": "independent_from_producer"
          }
        ]
      },
      {
        "id": "us.gwt_observable",
        "statement": "The Then clause of every acceptance scenario must represent observable behavior, not vague assertions like handled properly",
        "enforceability": "requires_criterion",
        "criterion_hint": "stories_are_invest_shaped",
        "evidence_hint": [
          {
            "required_fields": [
              {
                "semantics": "rfc6901",
                "pointer": "/samples"
              },
              {
                "semantics": "rfc6901",
                "pointer": "/agreement_basis_points"
              }
            ],
            "locator": "whole_subject_allowed",
            "binding": "target",
            "freshness": "target_bound",
            "provenance": "independent_from_producer"
          }
        ]
      },
      {
        "id": "us.small",
        "statement": "Individual story effort must not exceed 5 person-days",
        "enforceability": "requires_criterion",
        "criterion_hint": "stories_are_invest_shaped",
        "evidence_hint": [
          {
            "required_fields": [
              {
                "semantics": "rfc6901",
                "pointer": "/samples"
              },
              {
                "semantics": "rfc6901",
                "pointer": "/agreement_basis_points"
              }
            ],
            "locator": "whole_subject_allowed",
            "binding": "target",
            "freshness": "target_bound",
            "provenance": "independent_from_producer"
          }
        ]
      },
      {
        "id": "us.independent",
        "statement": "Blocked_by dependencies for a single story must not exceed 3, ensuring INVEST independence",
        "enforceability": "requires_criterion",
        "criterion_hint": "stories_are_invest_shaped",
        "evidence_hint": [
          {
            "required_fields": [

{
  "$id": "schema://software-architecture/invariant-candidate-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvariantCandidateManifest",
  "type": "object",
  "required": [
    "system_name",
    "candidate_invariants"
  ],
  "properties": {
    "system_name": {
      "type": "string"
    },
    "candidate_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "statement",
          "source_context",
          "criticality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-ARCH-[0-9]{3}$"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "compatibility_and_evolution",
              "layering_and_dependency",
              "data_consistency_and_storage",
              "concurrency_and_state",
              "security_and_tenant_isolation",
              "performance_and_resource_budget",
              "code_and_engineering_standards",
              "resilience_and_fault_tolerance",
              "observability_and_runtime_ops"
            ]
          },
          "statement": {
            "type": "string"
          },
          "source_context": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

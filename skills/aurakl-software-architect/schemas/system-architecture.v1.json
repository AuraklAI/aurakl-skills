{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/system-architecture/v1",
  "title": "SystemArchitectureSpec",
  "type": "object",
  "required": [
    "product_name",
    "architecture_pattern",
    "layer_count",
    "layers",
    "modules",
    "c4_container_diagram",
    "implements",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "architecture_pattern": {
      "type": "string",
      "enum": [
        "Modular_Monolith",
        "Microservices",
        "Layered_Monolith",
        "Event_Driven_Monolith"
      ]
    },
    "layer_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "name",
          "allowed_dependencies",
          "responsibility"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allowed_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responsibility": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "name",
          "layer_id",
          "dependencies",
          "implements_requirements"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layer_id": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implements_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z0-9_-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "c4_container_diagram": {
      "type": "string",
      "minLength": 10
    },
    "project_directory_layout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "owning_layer"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "owning_layer": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "package_or_crate_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_name", "package_kind", "dependencies", "exports"],
        "properties": {
          "package_name": { "type": "string" },
          "package_kind": { "type": "string", "enum": ["library_crate", "binary_crate", "core_domain", "infra_adapter", "api_transport"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exports": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9_-]+$"
      }
    },
    "overall_architecture_diagram": {
      "type": "string"
    },
    "monolith_justification": {
      "type": "string"
    },
    "four_plus_one_views": {
      "type": "object",
      "properties": {
        "logical_view": { "type": "object" },
        "development_view": { "type": "object" },
        "process_view": { "type": "object" },
        "physical_view": { "type": "object" },
        "scenarios_view": { "type": "object" }
      },
      "additionalProperties": true
    },
    "data_flows": {
      "type": "array"
    },
    "adrs": {
      "type": "array"
    },
    "cross_cutting_concerns": {
      "type": "object"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/layering-and-modules/v1",
  "title": "LayeringAndModules",
  "type": "object",
  "required": [
    "layer_count",
    "layers",
    "modules",
    "project_directory_layout",
    "package_or_crate_structure"
  ],
  "properties": {
    "layer_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "name",
          "allowed_dependencies",
          "responsibility"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allowed_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responsibility": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "name",
          "layer_id",
          "dependencies",
          "public_interfaces"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layer_id": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public_interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "project_directory_layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "purpose", "owning_layer"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "owning_layer": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "package_or_crate_structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["package_name", "package_kind", "dependencies", "exports"],
        "properties": {
          "package_name": { "type": "string" },
          "package_kind": { "type": "string", "enum": ["library_crate", "binary_crate", "core_domain", "infra_adapter", "api_transport"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exports": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

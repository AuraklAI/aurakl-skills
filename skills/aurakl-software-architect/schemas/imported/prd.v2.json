{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/prd/v2",
  "title": "ComprehensivePRDV2",
  "description": "Step 04 PRD artifact: IA, feature specs, state machines, error recovery, and tracking plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "background",
    "target_users",
    "goals",
    "non_goals",
    "information_architecture",
    "features",
    "state_machines",
    "error_handling_and_recovery",
    "tracking_plan",
    "non_functional_requirements",
    "dependencies_and_risks",
    "milestones",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "primary_job"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "primary_job": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "reason"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "information_architecture": {
      "type": "object",
      "description": "System information architecture and module topology",
      "additionalProperties": false,
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "module_name",
              "description",
              "hierarchy_level"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^MOD-[A-Z0-9]{2,8}$"
              },
              "module_name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "hierarchy_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "description": "Detailed feature inventory and behavioral specifications",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "name",
          "module_id",
          "derived_from_user_stories",
          "preconditions",
          "postconditions",
          "business_rules"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^FEAT-[A-Z0-9]{2,8}-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "module_id": {
            "type": "string",
            "pattern": "^MOD-[A-Z0-9]{2,8}$"
          },
          "derived_from_user_stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^USR-[A-Z0-9]{1,10}-[0-9]{3}$"
            }
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "postconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "business_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "state_machines": {
      "type": "array",
      "minItems": 1,
      "description": "Core business entity state machine models",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_name",
          "states",
          "transitions"
        ],
        "properties": {
          "entity_name": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state_id",
                "state_name",
                "is_initial",
                "is_terminal"
              ],
              "properties": {
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "state_name": {
                  "type": "string",
                  "minLength": 1
                },
                "is_initial": {
                  "type": "boolean"
                },
                "is_terminal": {
                  "type": "boolean"
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_state",
                "to_state",
                "trigger_event",
                "action"
              ],
              "properties": {
                "from_state": {
                  "type": "string",
                  "minLength": 1
                },
                "to_state": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger_event": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "error_handling_and_recovery": {
      "type": "object",
      "description": "Error handling, interruption recovery, and graceful degradation specification",
      "additionalProperties": false,
      "required": [
        "system_errors",
        "business_exceptions",
        "interruption_and_recovery"
      ],
      "properties": {
        "system_errors": {
          "type": "array",
          "minItems": 1,
          "description": "System-level exception handling (network timeout, rate limiting, unavailable dependency)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "error_code",
              "trigger_scenario",
              "retry_policy",
              "fallback_strategy"
            ],
            "properties": {
              "error_code": {
                "type": "string",
                "minLength": 1
              },
              "trigger_scenario": {
                "type": "string",
                "minLength": 1
              },
              "retry_policy": {
                "type": "string",
                "minLength": 1
              },
              "fallback_strategy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "business_exceptions": {
          "type": "array",
          "minItems": 1,
          "description": "Business exception handling (invalid input, concurrency conflicts, unauthorized access)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exception_code",
              "condition",
              "user_facing_message",
              "recovery_action"
            ],
            "properties": {
              "exception_code": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "user_facing_message": {
                "type": "string",
                "minLength": 1
              },
              "recovery_action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "interruption_and_recovery": {
          "type": "object",
          "description": "User active and passive interruption recovery protocol",
          "additionalProperties": false,
          "required": [
            "draft_persistence_strategy",
            "session_resume_protocol",
            "idempotency_guarantees"
          ],
          "properties": {
            "draft_persistence_strategy": {
              "type": "string",
              "minLength": 1,
              "description": "Autosave mechanism for draft state and interrupted input (e.g. LocalStorage / draft queue)"
            },
            "session_resume_protocol": {
              "type": "string",
              "minLength": 1,
              "description": "Lossless session restoration workflow upon user re-entry"
            },
            "idempotency_guarantees": {
              "type": "string",
              "minLength": 1,
              "description": "Idempotency and deduplication mechanisms under retries and poor network conditions"
            }
          }
        }
      }
    },
    "tracking_plan": {
      "type": "object",
      "description": "Tracking Plan telemetry dictionary and analytics metrics",
      "additionalProperties": false,
      "required": [
        "north_star_metric",
        "funnel_metrics",
        "event_dictionary",
        "quality_telemetry"
      ],
      "properties": {
        "north_star_metric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_name",
            "target_definition",
            "business_impact"
          ],
          "properties": {
            "metric_name": {
              "type": "string",
              "minLength": 1
            },
            "target_definition": {
              "type": "string",
              "minLength": 1
            },
            "business_impact": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "funnel_metrics": {
          "type": "array",
          "minItems": 1,
          "description": "Core business conversion funnel KPIs",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_name",
              "conversion_formula",
              "target_benchmark"
            ],
            "properties": {
              "step_name": {
                "type": "string",
                "minLength": 1
              },
              "conversion_formula": {
                "type": "string",
                "minLength": 1
              },
              "target_benchmark": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "event_dictionary": {
          "type": "array",
          "minItems": 2,
          "description": "User behavioral event telemetry schema",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_name",
              "trigger_condition",
              "event_properties",
              "user_properties"
            ],
            "properties": {
              "event_name": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$",
                "description": "e.g. order_submitted, search_executed"
              },
              "trigger_condition": {
                "type": "string",
                "minLength": 1
              },
              "event_properties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "user_properties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "quality_telemetry": {
          "type": "array",
          "minItems": 1,
          "description": "System performance and UX telemetry health indicators",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "telemetry_name",
              "alert_threshold",
              "sla_target"
            ],
            "properties": {
              "telemetry_name": {
                "type": "string",
                "minLength": 1
              },
              "alert_threshold": {
                "type": "string",
                "minLength": 1
              },
              "sla_target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "non_functional_requirements": {
      "type": "object",
      "description": "Non-functional requirements specification",
      "additionalProperties": false,
      "required": [
        "performance",
        "security",
        "privacy",
        "availability",
        "compliance"
      ],
      "properties": {
        "performance": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "compliance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies_and_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "description",
          "mitigation_plan"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "technical_dependency",
              "external_api",
              "policy_risk",
              "schedule_risk"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mitigation_plan": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_name",
          "target_deliverables",
          "estimated_timeline"
        ],
        "properties": {
          "phase_name": {
            "type": "string",
            "minLength": 1
          },
          "target_deliverables": {
            "type": "string",
            "minLength": 1
          },
          "estimated_timeline": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

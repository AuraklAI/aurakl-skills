{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://product-management/user-story-set/v2",
  "title": "UserStorySetV2",
  "description": "Step 03 artifact: INVEST user stories derived from journey touchpoints, focusing on user business value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "epics",
    "stories",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "epics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "description": "Epics organized by user journey stages",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "value_statement",
          "journey_stage_id",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value_statement": {
            "type": "string",
            "minLength": 1
          },
          "journey_stage_id": {
            "type": "string",
            "pattern": "^STG-[0-9]{3}$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "description": "User story inventory adhering to INVEST principles",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_epic",
          "as_a",
          "i_want",
          "so_that",
          "priority",
          "estimate_story_points",
          "related_touchpoint_id",
          "implements_requirement_ids",
          "value_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^USR-[A-Z0-9]{1,10}-[0-9]{3}$",
            "description": "USR-<MODULE>-001"
          },
          "parent_epic": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "as_a": {
            "type": "string",
            "minLength": 1,
            "description": "Specific persona role (from Persona library)"
          },
          "i_want": {
            "type": "string",
            "minLength": 1,
            "description": "User capability request"
          },
          "so_that": {
            "type": "string",
            "minLength": 1,
            "description": "Measurable user business value"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "estimate_story_points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13,
            "description": "Story point estimate adhering to Small sizing"
          },
          "related_touchpoint_id": {
            "type": "string",
            "pattern": "^TP-[0-9]{3}$",
            "description": "Mapped journey touchpoint ID"
          },
          "implements_requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQA-[0-9]{3}$"
            }
          },
          "value_criteria": {
            "type": "array",
            "minItems": 1,
            "description": "User-perspective acceptance criteria focusing on value realization and input boundaries",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/api-endpoints-manifest/v1",
  "title": "ApiEndpointsManifest",
  "type": "object",
  "required": [
    "base_url",
    "protocols",
    "endpoints"
  ],
  "properties": {
    "base_url": {
      "type": "string"
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "HTTP_REST",
          "gRPC",
          "WebSocket",
          "Async_MQ"
        ]
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "endpoint_id",
          "path",
          "method",
          "protocol",
          "summary",
          "auth_required"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^API-[0-9]{3,}$"
          },
          "path": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "RPC",
              "PUB_SUB"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "auth_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/business-sequence-flows/v1",
  "title": "BusinessSequenceFlows",
  "type": "object",
  "required": [
    "sequence_flows"
  ],
  "properties": {
    "sequence_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "flow_id",
          "title",
          "path_kind",
          "participants",
          "mermaid_sequence_diagram",
          "step_by_step_narration"
        ],
        "properties": {
          "flow_id": {
            "type": "string",
            "pattern": "^FLOW-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "path_kind": {
            "type": "string",
            "enum": ["happy_path", "rejection_path", "recovery_path"]
          },
          "participants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "mermaid_sequence_diagram": {
            "type": "string",
            "minLength": 10
          },
          "step_by_step_narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

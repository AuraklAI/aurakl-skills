{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/physical-schema-and-indexes/v1",
  "title": "PhysicalSchemaAndIndexes",
  "type": "object",
  "required": [
    "database_engine",
    "tables"
  ],
  "properties": {
    "database_engine": {
      "type": "string"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "table_name",
          "description",
          "columns",
          "primary_key",
          "indexes"
        ],
        "properties": {
          "table_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "data_type",
                "nullable",
                "default_value",
                "comment"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "data_type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "default_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "comment": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "primary_key": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index_name",
                "columns",
                "unique",
                "index_type"
              ],
              "properties": {
                "index_name": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "unique": {
                  "type": "boolean"
                },
                "index_type": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/api-contracts/v1",
  "title": "ApiContractSuite",
  "type": "object",
  "required": [
    "product_name",
    "base_url",
    "global_error_codes",
    "endpoints",
    "idempotency_rules",
    "backward_compatibility_guarantee",
    "implements",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string"
    },
    "global_error_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "http_status",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "http_status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "endpoint_id",
          "path",
          "method",
          "protocol",
          "summary",
          "request_schema",
          "response_schema",
          "implements_requirements"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^API-[0-9]{3,}$"
          },
          "path": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "RPC",
              "PUB_SUB"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "request_schema": {
            "type": "object"
          },
          "response_schema": {
            "type": "object"
          },
          "error_responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "error_code",
                "condition"
              ],
              "properties": {
                "error_code": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "implements_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z0-9_-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "idempotency_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "endpoint_pattern",
          "mechanism"
        ],
        "properties": {
          "endpoint_pattern": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "backward_compatibility_guarantee": {
      "type": "object",
      "required": [
        "breaking_changes_allowed",
        "deprecation_policy"
      ],
      "properties": {
        "breaking_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "deprecation_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9_-]+$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/database-design/v1",
  "title": "DatabaseDesignSpec",
  "type": "object",
  "required": [
    "product_name",
    "database_engine",
    "entities",
    "tables",
    "invariant_enforcements",
    "migration_and_seed_strategy",
    "implements",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "database_engine": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_name",
          "description",
          "attributes",
          "primary_identifier"
        ],
        "properties": {
          "entity_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "nullable",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "primary_identifier": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "table_name",
          "description",
          "columns",
          "primary_key",
          "indexes",
          "implements_requirements"
        ],
        "properties": {
          "table_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "data_type",
                "nullable",
                "default_value",
                "comment"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "data_type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "default_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "comment": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "primary_key": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index_name",
                "columns",
                "unique",
                "index_type"
              ],
              "properties": {
                "index_name": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "unique": {
                  "type": "boolean"
                },
                "index_type": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "implements_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z0-9_-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariant_enforcements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "invariant_id",
          "enforcement_mechanism",
          "schema_constraints"
        ],
        "properties": {
          "invariant_id": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9_-]+$"
          },
          "enforcement_mechanism": {
            "type": "string"
          },
          "schema_constraints": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "migration_and_seed_strategy": {
      "type": "object",
      "required": [
        "migration_tool",
        "rollback_strategy"
      ],
      "properties": {
        "migration_tool": {
          "type": "string"
        },
        "rollback_strategy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "caching_strategy": {
      "type": "object",
      "properties": {
        "cache_engine": { "type": "string" },
        "eviction_policy": { "type": "string" },
        "cache_aside_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9_-]+$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}

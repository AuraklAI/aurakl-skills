{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://software-architecture/business-flow/v1",
  "title": "BusinessFlowSpec",
  "type": "object",
  "required": [
    "product_name",
    "sequence_flows",
    "state_machines",
    "concurrency_control",
    "transaction_boundaries",
    "implements",
    "summary"
  ],
  "properties": {
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "sequence_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "flow_id",
          "title",
          "path_kind",
          "participants",
          "mermaid_sequence_diagram",
          "step_by_step_narration",
          "implements_requirements"
        ],
        "properties": {
          "flow_id": {
            "type": "string",
            "pattern": "^FLOW-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "path_kind": {
            "type": "string",
            "enum": ["happy_path", "rejection_path", "recovery_path"]
          },
          "participants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "mermaid_sequence_diagram": {
            "type": "string",
            "minLength": 10
          },
          "step_by_step_narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "implements_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z0-9_-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "state_machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_name",
          "initial_state",
          "terminal_states",
          "states",
          "transitions"
        ],
        "properties": {
          "entity_name": {
            "type": "string"
          },
          "initial_state": {
            "type": "string"
          },
          "terminal_states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "from_state",
                "to_state",
                "trigger_event",
                "guard_condition"
              ],
              "properties": {
                "from_state": {
                  "type": "string"
                },
                "to_state": {
                  "type": "string"
                },
                "trigger_event": {
                  "type": "string"
                },
                "guard_condition": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "concurrency_control": {
      "type": "object",
      "required": [
        "locking_strategy",
        "race_condition_mitigations"
      ],
      "properties": {
        "locking_strategy": {
          "type": "string"
        },
        "race_condition_mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "transaction_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "boundary_type",
          "rollback_mechanism"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "boundary_type": {
            "type": "string",
            "enum": [
              "DB_TRANSACTION",
              "SAGA_ORCHESTRATION",
              "TCC",
              "LOCAL_ATOMIC"
            ]
          },
          "rollback_mechanism": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9_-]+$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
